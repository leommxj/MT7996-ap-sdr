"""Rewrite only the v2 chainloader slot through stock U-Boot; UBI is untouched."""
import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from initkit import config, session, migrate, console as unit
from initkit.console import StepFailed


def main():
    settings = config.load()
    parser = argparse.ArgumentParser(description=__doc__)
    config.add_arguments(parser, settings)
    parser.add_argument('--no-reset', action='store_true')
    args = parser.parse_args()
    config.require_images(config.CHAINLOADER)
    try:
        with session.open_session(session.settings_from(args), 'chainloader',
                                  write=True) as run:
            console, log = run.console, run.log
            state = unit.identify(console, log)
            print(f'chainloader: the unit is at: {state}')
            unit.to_stock(console, log, state, fresh=True)
            migrate.write_chainloader(run)
            if not args.no_reset:
                console.send_async('reset')
        print('chainloader: slot updated; UBI untouched')
        return 0
    except (StepFailed, RuntimeError) as error:
        sys.exit(f'chainloader: {error}')


if __name__ == '__main__':
    sys.exit(main())
