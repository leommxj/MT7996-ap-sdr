#!/bin/sh
# SPDX-License-Identifier: MIT
# Check the storage invariants of a normal boot: SquashFS lower under an
# overlay whose upper is the UBI data volume, the expected UBI volumes, and
# only tmpfs for the volatile directories. Recovery boots skip NAND checks.
# A data/overlay failure prints W1700K_STORAGE_DEGRADED and exits non-zero; it
# does not stop the boot.
set -u
. /etc/w1700k/storage.conf
fail() { echo "W1700K_STORAGE_DEGRADED: $*" >&2; exit 1; }

mode=system
for arg in $(cat /proc/cmdline); do
	case $arg in
	sdr.mode=*) mode=${arg#sdr.mode=} ;;
	esac
done

grep -Eq '^overlay / overlay rw,.*lowerdir=' /proc/mounts || fail "root is not OverlayFS"
grep -Eq ' /\.lower squashfs ro[, ]' /proc/mounts || fail "lower root is not read-only SquashFS"
for row in "/run:$RUN_SIZE" "/tmp:$TMP_SIZE" "/var/tmp:$VAR_TMP_SIZE" \
	   "/work:$WORK_SIZE" "/var/log:$LOG_SIZE"; do
	path=${row%%:*}; size=${row#*:}
	grep -Eq " ${path} tmpfs rw,.*size=${size}" /proc/mounts || fail "$path tmpfs size differs"
done

for node in /dev/ubiblock*; do
	[ -e "$node" ] && fail "ubiblock is present"
done
[ ! -e /sys/kernel/sdr_bmt/counters ] || fail "the BMT layer is loaded"

if [ "$mode" = recovery ]; then
	echo W1700K_STORAGE_READY
	exit 0
fi

grep -q " $DATA_MOUNT ubifs " /proc/mounts || fail "$DATA_MOUNT is not UBIFS"
grep -Fq "upperdir=$OVERLAY_UPPER" /proc/mounts || fail "root upper is not $OVERLAY_UPPER"
for path in "$OVERLAY_UPPER" "$OVERLAY_WORK" "$DATA_MOUNT/logs" \
	    "$DATA_MOUNT/recordings" "$DATA_MOUNT/spectrumd"; do
	[ -d "$path" ] || fail "$path is missing"
done

[ -d /sys/class/ubi/ubi0 ] || fail "ubi0 is not attached"
for name in ubootenv ubootenv2 fit_a fit_b recovery data; do
	found=0
	for node in /sys/class/ubi/ubi0_*/name; do
		[ -r "$node" ] || continue
		[ "$(cat "$node")" = "$name" ] && found=1
	done
	[ "$found" -eq 1 ] || fail "UBI volume $name is missing"
done
echo W1700K_STORAGE_READY
