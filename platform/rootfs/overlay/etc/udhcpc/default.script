#!/bin/sh
# SPDX-License-Identifier: MIT
# Minimal BusyBox udhcpc lease script for the management ports.
set -u
case "${1:-}" in
deconfig)
	ip -4 addr flush dev "$interface" 2>/dev/null || true
	ip link set "$interface" up 2>/dev/null || true
	;;
bound|renew)
	ip -4 addr flush dev "$interface" 2>/dev/null || true
	ip -4 addr add "$ip/$mask" dev "$interface" || exit 1
	if [ -n "${router:-}" ]; then
		ip -4 route replace default via "$router" dev "$interface" metric 100 ||
			exit 1
	fi
	if [ -n "${dns:-}" ]; then
		: > /etc/resolv.conf
		for server in $dns; do
			echo "nameserver $server" >> /etc/resolv.conf
		done
	fi
	;;
esac
exit 0
