# SPDX-License-Identifier: MIT
BR2_aarch64=y
BR2_cortex_a53=y
BR2_REPRODUCIBLE=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_STATIC_LIBS=y
BR2_INIT_BUSYBOX=y
BR2_TARGET_GENERIC_HOSTNAME="w1700k-sdr"
BR2_TARGET_GENERIC_ISSUE="W1700K SDR"
# Development default: password login is enabled so a fresh unit can be reached
# without a pre-generated key. A provisioned unit may still carry authorized
# keys; keys added at runtime persist in the /data overlay.
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_PASSWD_SHA512=y
BR2_TARGET_GENERIC_ROOT_PASSWD="123456"
# The overlay supplies inittab and rcS, and the bootstrap initramfs assembles
# the RAM overlay over the read-only root.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_PACKAGE_BUSYBOX=y
# fw_printenv/fw_setenv for maintenance of the loader environment; startup
# never runs them.
BR2_PACKAGE_LIBUBOOTENV=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_PCIUTILS=y
# Temporary/on-image TCP/UDP throughput testing; static musl binary.
BR2_PACKAGE_IPERF3=y
# One deterministic read-only image; platform/bootstrap builds the small
# initramfs that mounts it.
# BR2_TARGET_ROOTFS_CPIO is not set
# BR2_TARGET_ROOTFS_UBIFS is not set
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_128K=y
BR2_TARGET_ROOTFS_SQUASHFS_PAD=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_SQUASHFS_EXTREME_COMP=y
# BR2_TARGET_ROOTFS_TAR is not set
# BR2_PACKAGE_OPENSSH is not set
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_DROPBEAR_SMALL=y
BR2_PACKAGE_GESFTPSERVER=y
# Root login accepts a password or, when init/provision adds one, a key.
# BR2_PACKAGE_HOSTAPD is not set
# BR2_PACKAGE_WPA_SUPPLICANT is not set
# BR2_PACKAGE_DNSMASQ is not set
# BR2_PACKAGE_SYSTEMD is not set

# NAND and UBI maintenance tools; host mkfs.ubifs builds the durable image.
BR2_PACKAGE_MTD=y
BR2_PACKAGE_HOST_MTD=y
# BR2_PACKAGE_MTD_JFFS_UTILS is not set
# BR2_PACKAGE_MTD_UBIFS_UTILS is not set
# BR2_PACKAGE_MTD_DOCFDISK is not set
# BR2_PACKAGE_MTD_DOC_LOADBIOS is not set
# BR2_PACKAGE_MTD_FLASHCP is not set
BR2_PACKAGE_MTD_FLASH_ERASE=y
# BR2_PACKAGE_MTD_FLASH_LOCK is not set
# BR2_PACKAGE_MTD_FLASH_OTP_DUMP is not set
# BR2_PACKAGE_MTD_FLASH_OTP_INFO is not set
# BR2_PACKAGE_MTD_FLASH_OTP_LOCK is not set
# BR2_PACKAGE_MTD_FLASH_OTP_WRITE is not set
# BR2_PACKAGE_MTD_FLASH_OTP_ERASE is not set
# BR2_PACKAGE_MTD_FLASH_UNLOCK is not set
# BR2_PACKAGE_MTD_FSCKUBIFS is not set
# BR2_PACKAGE_MTD_FTL_CHECK is not set
# BR2_PACKAGE_MTD_FTL_FORMAT is not set
# BR2_PACKAGE_MTD_JFFS2DUMP is not set
# BR2_PACKAGE_MTD_LSMTD is not set
# BR2_PACKAGE_MTD_MKFSJFFS2 is not set
# BR2_PACKAGE_MTD_MKFSUBIFS is not set
# BR2_PACKAGE_MTD_MTD_DEBUG is not set
# BR2_PACKAGE_MTD_MTDPART is not set
BR2_PACKAGE_MTD_NANDDUMP=y
# BR2_PACKAGE_MTD_NANDTEST is not set
BR2_PACKAGE_MTD_NANDWRITE=y
# BR2_PACKAGE_MTD_NANDFLIPBITS is not set
# BR2_PACKAGE_MTD_NFTLDUMP is not set
# BR2_PACKAGE_MTD_NFTL_FORMAT is not set
# BR2_PACKAGE_MTD_RECV_IMAGE is not set
# BR2_PACKAGE_MTD_RFDDUMP is not set
# BR2_PACKAGE_MTD_RFDFORMAT is not set
# BR2_PACKAGE_MTD_SERVE_IMAGE is not set
# BR2_PACKAGE_MTD_SUMTOOL is not set
BR2_PACKAGE_MTD_MTDINFO=y
BR2_PACKAGE_MTD_UBIATTACH=y
# BR2_PACKAGE_MTD_UBICRC32 is not set
BR2_PACKAGE_MTD_UBIDETACH=y
BR2_PACKAGE_MTD_UBIFORMAT=y
# BR2_PACKAGE_MTD_UBIHEALTHD is not set
BR2_PACKAGE_MTD_UBIMKVOL=y
BR2_PACKAGE_MTD_UBINFO=y
# BR2_PACKAGE_MTD_UBINIZE is not set
# BR2_PACKAGE_MTD_UBIRENAME is not set
BR2_PACKAGE_MTD_UBIRMVOL=y
# BR2_PACKAGE_MTD_UBIRSVOL is not set
BR2_PACKAGE_MTD_UBIUPDATEVOL=y
# BR2_PACKAGE_MTD_UBIBLOCK is not set
# BR2_PACKAGE_MTD_TESTS is not set
# BR2_PACKAGE_MTD_FLASH_READTEST is not set
# BR2_PACKAGE_MTD_FLASH_SPEED is not set
# BR2_PACKAGE_MTD_FLASH_STRESS is not set
# BR2_PACKAGE_MTD_FLASH_TORTURE is not set
# BR2_PACKAGE_MTD_INTEGCK is not set
# BR2_PACKAGE_MTD_NANDBITERRS is not set
# BR2_PACKAGE_MTD_NANDPAGETEST is not set
# BR2_PACKAGE_MTD_NANDSUBPAGETEST is not set
